FROM dats_deps:latest AS deps_runtime

FROM ubuntu:latest AS builder
# Install build dependencies
RUN apt-get update && apt-get install -y \
    vim cmake curl build-essential libapr1-dev libaprutil1-dev git \
    libboost-all-dev sqlite3 libsqlite3-dev libtool libasio-dev \
    libtinyxml2-dev zip python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy the built dependencies from dats_deps 
COPY --from=deps_runtime /usr/local /usr/local



WORKDIR /opt/distributed_ats_src

COPY . /opt/distributed_ats_src

ADD docker/build_distributed_ats.sh /build_distributed_ats.sh
RUN chmod +x /build_distributed_ats.sh && /build_distributed_ats.sh

FROM ubuntu:latest
WORKDIR /app
COPY --from=builder /usr/local/ /app/
COPY docker/FastDDS.xml /app/config/FastDDS.xml
COPY docker/logging.properties /app/config/logging.properties
ENV FASTDDS_DEFAULT_PROFILES_FILE=/app/config/FastDDS.xml
CMD ["/bin/bash"]
RUN apt-get update && apt-get install --no-install-recommends -y \
    libboost-all-dev vim python3-pip libapr1-dev libaprutil1-dev libtinyxml2-dev \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
